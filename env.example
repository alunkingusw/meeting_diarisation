POSTGRES_DB=db_name
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
SECRET_KEY=secretkeystring

# Optional: create the first administrator on startup, but only when the users table is empty.
# Use a unique password of at least 12 characters, then remove these values after first startup.
# INITIAL_ADMIN_USERNAME=your_username
# INITIAL_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
# INITIAL_ADMIN_EMAIL=you@example.com

# Shared secret for trusted backend-to-backend callers (e.g. GroupAssessmentAgent) hitting
# /admin/* - sent as the X-Service-Key header, never as a per-user JWT. Generate a long random
# value and share it out-of-band; never commit the real value.
SERVICE_API_KEY=generate_a_long_random_value
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
HUGGING_FACE_TOKEN=generate_at_huggingface

# CPU is the default. See README.md to build and select a CUDA image.
API_BASE_IMAGE=meeting-api-torch:cpu

# Port the frontend dev server listens on and is published on - also used to build the
# backend's CORS allow list, so change this instead of editing docker-compose.yml/main.py directly.
FRONTEND_PORT=5000

# Hostname or IP the browser uses to reach this stack, e.g. when the containers run on a
# different machine to the browser. Leave unset for local development (defaults to localhost).
# Used to build NEXT_PUBLIC_API_URL and the backend's CORS allow list - change this instead of
# editing docker-compose.yml/main.py directly.
# PUBLIC_HOST=192.168.1.50
EMAIL_API_TOKEN=your_email_api_token
# GitHub/Trello credentials used when ingesting a group's linked repo and board.
# GITHUB_TOKEN is optional for public repos; Trello is skipped unless both values are set.
GITHUB_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
UPLOAD_DIR=/backend/uploads