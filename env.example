POSTGRES_DB=db_name
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
SECRET_KEY=secretkeystring
# Shared secret for trusted backend-to-backend callers (e.g. GroupAssessmentAgent) hitting
# /admin/* - sent as the X-Service-Key header, never as a per-user JWT. Generate a long random
# value and share it out-of-band; never commit the real value.
SERVICE_API_KEY=generate_a_long_random_value
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
HUGGING_FACE_TOKEN=generate_at_huggingface
UPLOAD_DIR=/backend/uploads