# Copy this file to .env and replace every placeholder with your own real values.
# Never commit .env to source control.

# --- Project mailbox: standard IMAP/SMTP provider (e.g. mailbox.org) ---
# Set mail.provider to "mail" in config/config.yaml.
# Use the mailbox address you created for the project, not your personal account.
MAIL_USERNAME=project@yourmailbox.example
MAIL_PASSWORD=replace-with-your-mailbox-app-password-or-IMAP-password

# --- Microsoft Graph (optional alternative to the mailbox provider) ---
# Only needed if you choose Graph instead of the generic mail provider.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Admin notifications ---
# Who should be emailed when unauthorised senders, parse failures, backend failures, or
# infrastructure problems occur.
ADMIN_EMAIL=admin@yourdomain.example

# --- Authorised sender domains ---
# Comma-separated domains whose authenticated senders may email the project without being a
# registered group owner. Senders outside these domains, or those failing SPF/DKIM/DMARC,
# are silently dropped.
AUTHORISED_EMAIL_DOMAINS=yourdomain.example,example.edu

# --- meeting_diarisation service key ---
# Must match SERVICE_API_KEY in meeting_diarisation's own .env - used to call its /admin/*
# endpoints (currently just /admin/group-owners, which replaces the old static group_owners
# map) as a trusted backend-to-backend caller, never as a specific user.
DIARISATION_SERVICE_API_KEY=

# --- Internal email API (only needed when internal_api.enabled is true) ---
EMAIL_API_TOKEN=replace-with-a-long-random-service-token

# --- Group-owner mapping (optional static override) ---
# Not environment variables; belongs in config/config.yaml under authorisation.group_owners.
# Normally left unset now that group-owners are fetched live from meeting_diarisation (see
# DIARISATION_SERVICE_API_KEY above) - only set this for a backend-less dev run:
# authorisation:
#   group_owners:
#     alice@yourdomain.example: 12
#     bob@yourdomain.example: 7
